# Local development environment variables
# These are just test values for local development.
# Copy to .env.local and fill in real values.

NEXT_PUBLIC_KOOMPI_PROVIDER_CLIENT_ID=test_client_id
NEXT_PUBLIC_KOOMPI_PROVIDER_CLIENT_SECRET=test_client_secret
NEXT_PUBLIC_KOOMPI_PROVIDER_REDIRECT_URI=http://localhost:3000/auth/callback

# Database (Turso / libSQL)
# Use a local file for offline dev:
DATABASE_URL=file:./data/dev.db
# ...or point at a Turso database:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token_here
