# Sign in with KOOMPI ID (through KOOMPI Cloud)
# Set automatically when the app is deployed or previewed on KOOMPI Cloud.
# NEXT_PUBLIC_ ones reach the browser; the client secret is the server's only
# (it swaps the sign-in's one-time code for the tokens).

NEXT_PUBLIC_KOOMPI_PROVIDER_CLIENT_ID="your_client_id_here"
KOOMPI_PROVIDER_CLIENT_SECRET="your_client_secret_here"
NEXT_PUBLIC_KOOMPI_PROVIDER_REDIRECT_URI="https://your-service-domain.tunnel.koompi.cloud/api/auth/callback"
NEXT_PUBLIC_KOOMPI_API_BASE_URL="https://api-kconsole.koompi.cloud"

# Database (Turso / libSQL) - provisioned automatically when deployed on KOOMPI Cloud.
# For local dev you can point at a Turso DB, or use a local file: URL (file:./data/dev.db).
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your_turso_auth_token_here"

# Object storage (KOOMPI Cloud Storage) - injected automatically on KOOMPI Cloud
KCONSOLE_STORAGE_URL="https://api-kconsole.koompi.cloud"
KCONSOLE_STORAGE_KEY="your_storage_api_key_here"

# Payments (KOOMPI Cloud) - set when payments are turned on for the app
# (Ask AI's add_payments, or Payments in the dashboard). Customers pay with ABA,
# ACLEDA, Wing or KHQR. Without them the payment card stays hidden.
KOOMPI_PAY_URL="https://api-kconsole.koompi.cloud/api/pay"
KOOMPI_PAY_KEY="kp_test_your_key_here"
KOOMPI_PAY_WEBHOOK_SECRET="whsec_your_secret_here"

# App Configuration
NODE_ENV="production"
PORT=3000
