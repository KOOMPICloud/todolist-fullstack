# KOOMPI Provider OAuth Credentials
# These will be injected automatically when deployed on KConsole
# NEXT_PUBLIC_ prefix is required for client-side access in Next.js

NEXT_PUBLIC_KOOMPI_PROVIDER_CLIENT_ID="your_client_id_here"
NEXT_PUBLIC_KOOMPI_PROVIDER_CLIENT_SECRET="your_client_secret_here"
NEXT_PUBLIC_KOOMPI_PROVIDER_REDIRECT_URI="https://your-service-domain.tunnel.koompi.cloud/auth/callback"
NEXT_PUBLIC_KOOMPI_API_BASE_URL="https://api-kconsole.koompi.cloud"

# Database (Turso / libSQL) - provisioned automatically when deployed on KConsole.
# For local dev you can point at a Turso DB, or use a local file: URL (file:./data/dev.db).
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your_turso_auth_token_here"

# Object storage (KConsole Storage) - injected automatically on KConsole
KCONSOLE_STORAGE_URL="https://api-kconsole.koompi.cloud"
KCONSOLE_STORAGE_KEY="your_storage_api_key_here"

# App Configuration
NODE_ENV="production"
PORT=3000
